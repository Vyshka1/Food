# Служба разбора ссылок.
#
# node:22-alpine — как у соседних проектов на этом сервере. yt-dlp ставится
# пакетом: без него ссылки на ролики не работают, а на блоги — работают.
FROM node:22-alpine

RUN apk add --no-cache yt-dlp

WORKDIR /app
COPY server ./server

# Внутри контейнера «все интерфейсы» — это сеть контейнера, наружу она не
# выходит. Снаружи к службе можно попасть только через Traefik, и только по /api
ENV PORT=8080
ENV HOST=0.0.0.0

# Служба ходит в интернет по чужим ссылкам — пусть делает это не от root
USER node

EXPOSE 8080
CMD ["node", "server/index.mjs"]
